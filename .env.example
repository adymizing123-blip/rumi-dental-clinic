# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=          # publishable / anon key
SUPABASE_SERVICE_ROLE_KEY=              # secret key, server only. Never expose to the browser.

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- WhatsApp Cloud API (connected manually by the developer, per clinic) ---
WHATSAPP_ACCESS_TOKEN=                  # permanent system user token
WHATSAPP_PHONE_NUMBER_ID=               # WhatsApp > API Setup
WHATSAPP_BUSINESS_ACCOUNT_ID=           # WhatsApp > API Setup
META_APP_SECRET=                        # App settings > Basic (used to verify webhook signatures)
META_WEBHOOK_VERIFY_TOKEN=              # any long random string; paste the same value in Meta
META_GRAPH_VERSION=v23.0
INSTAGRAM_APP_SECRET=                   # only if you use "Instagram API with Instagram Login" (its own app secret)
# Facebook Pages, Instagram accounts and extra WhatsApp numbers are added in CRM → Settings → Channels.

# --- AI receptionist + summaries (optional; the CRM works without it) ---
AI_PROVIDER=anthropic                   # anthropic | openai  ("openai" = any OpenAI-compatible API)
AI_API_KEY=
AI_MODEL=                               # empty = claude-haiku-5-5 for anthropic; REQUIRED for openai-compatible
AI_BASE_URL=                            # e.g. https://generativelanguage.googleapis.com/v1beta/openai/ for Google Gemini
AI_REPLY_DELAY_MS=2500                  # waits for the patient to finish typing before replying
AI_MAX_REPLIES_PER_DAY=30               # per chat; AI pauses and hands over after this
AI_PAUSE_ON_STAFF_REPLY=true            # AI steps back on a chat as soon as staff replies

# --- Automations (WhatsApp messages to patients and doctors) ---
CRON_SECRET=                            # long random string; the 5-minute scheduler sends it to /api/cron/automations
DOCTOR_SCHEDULE_HOUR=8                  # clinic time when doctors get today's schedule
